{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"], "module": "Preserve", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "esModuleInterop": true, "skipLibCheck": true, "jsx": "preserve", "isolatedModules": true, "resolveJsonModule": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
