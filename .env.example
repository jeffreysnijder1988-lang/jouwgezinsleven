# Canonieke URL van de site (zonder trailing slash)
PUBLIC_SITE_URL=https://jouwgezinsleven.nl

# Sanity — project "Jouw Gezinsleven"
SANITY_PROJECT_ID=amxuxo0p
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19

# Alleen nodig als de dataset ooit private wordt. Nooit committen.
# Read-token (Viewer). Build gebruikt ALTIJD perspective "published": drafts komen nooit in de build.
SANITY_READ_TOKEN=

# Contentbron: "sanity" (standaard, productie) of "fixture" (alleen lokale QA met testdata)
CONTENT_SOURCE=sanity

# Zet op 1 voor een testomgeving: alles noindex + robots Disallow
PUBLIC_NOINDEX_SITE=

# --- Deploy (lokaal of in GitHub Environments; NOOIT committen) ---
# DEPLOY_PROTOCOL=sftp            # sftp (voorkeur) of ftps
# DEPLOY_HOST=
# DEPLOY_PORT=
# DEPLOY_USER=
# DEPLOY_PASSWORD=                # of DEPLOY_SSH_KEY (sftp)
# DEPLOY_KNOWN_HOSTS=             # sftp: uitvoer van ssh-keyscan -p <poort> <host>
# DEPLOY_PATH=                    # absolute document root, bijv. /home/<account>/public_html
# DEPLOY_SITE_URL=https://jouwgezinsleven.nl
