---
/** 404 — ontwerp van de bestaande site (verloop, witte kaart). Zoekformulier weggelaten: /zoeken/ bestaat niet. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteSettings } from '@/lib/content';
import { buildMeta } from '@/lib/seo/meta';
const settings = await getSiteSettings();
const meta = buildMeta({ path: '/404/', site: Astro.site, settings, title: 'Pagina niet gevonden', noIndex: true, fallbackDescription: 'Deze pagina is er niet (meer).' });
---
<BaseLayout meta={meta} bare>
  <div class="nf">
    <div class="box">
      <h1>Deze pagina is er niet (meer).</h1>
      <p>Misschien is de link verhuisd, of zat er een typfout in. Kies een onderwerp of ga naar de <a href="/">homepage</a>.</p>
      {settings.mainNav.length > 0 && (
        <ul class="links">{settings.mainNav.map((p) => <li><a href={`/${p.slug}/`}>{p.navLabel || p.name}</a></li>)}</ul>
      )}
    </div>
  </div>
</BaseLayout>
<style>
  .nf { flex: 1; display: flex; align-items: center; justify-content: center; padding: 40px var(--gutter) 80px; min-height: 60vh; }
  .box { background: var(--color-white); border-radius: 28px; padding: 44px 32px; max-width: 640px; width: 100%; text-align: center; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.4rem); line-height: 1.1; margin: 0 0 .3em; }
  p { color: var(--color-text-muted); margin: 0 0 1.4em; }
  p a { text-decoration: underline; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .links a { display: block; background: var(--color-pink-soft); font-family: var(--font-heading); font-weight: var(--weight-heading); padding: 10px 18px; border-radius: var(--radius-pill); font-size: var(--text-small); }
  .links a:hover { background: var(--color-coral); text-decoration: none; }
</style>
