---
/**
 * Eén hero-component voor alle paginatypes (bestaande site).
 *  variant "home": oranje-geel verloop, grote H1, uitgesneden foto rechts, dubbele golf.
 *  variant "hub":  gekleurde pijler-hero met kruimelpad, H1, intro en decoratieve illustratie.
 *  variant "plain": rustige kop voor artikelen/pagina's (crème vlak + golf).
 */
import type { SanityImage } from '@/lib/content/types';
import type { Crumb } from '@/lib/schema/jsonld';
import type { HubTheme } from '@/lib/helpers/theme';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import SanityImg from '@/components/ui/SanityImg.astro';
import WaveDivider from '@/components/ui/WaveDivider.astro';
import Illustration from '@/components/ui/Illustration.astro';
import { hasImage, imageUrl } from '@/lib/sanity/image';
interface Props {
  title: string;
  intro?: string | null;
  eyebrow?: string | null;
  image?: SanityImage | null;
  variant?: 'home' | 'hub' | 'plain';
  theme?: HubTheme;
  crumbs?: Crumb[];
}
const { title, intro, eyebrow, image, variant = 'plain', theme = 'creme', crumbs = [] } = Astro.props;
const img = hasImage(image) ? image : null;
const w = img?.asset?.width ?? 981;
const h = img?.asset?.height ?? 917;
---
{variant === 'home' && (
  <section class="hero hero--home" aria-labelledby="hero-titel">
    <div class="container hero__grid">
      <div class="hero__tekst">
        <h1 id="hero-titel">{title}</h1>
        {intro && <p class="hero__intro">{intro}</p>}
        <slot />
      </div>
      {img && (
        <div class="hero__visual">
          <img
            src={imageUrl(img, 981)}
            srcset={`${imageUrl(img, 540)} 540w, ${imageUrl(img, 981)} 981w`}
            sizes="(min-width: 860px) 540px, 100vw"
            alt={img.alt ?? ''} width={w} height={h} fetchpriority="high" decoding="async"
          />
        </div>
      )}
    </div>
    <WaveDivider double />
  </section>
)}

{variant === 'hub' && (
  <section class:list={['hero', 'hero--hub', `hero--${theme}`]} aria-labelledby="hero-titel">
    <div class="container hero__grid hero__grid--hub">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1 id="hero-titel">{title}</h1>
        {intro && <p class="hero__intro">{intro}</p>}
        <slot />
      </div>
      <div class="hero__illu"><Illustration kind="hub" name={theme} /></div>
    </div>
    <WaveDivider />
  </section>
)}

{variant === 'plain' && (
  <>
    <section class="hero hero--plain" aria-labelledby="hero-titel">
      <div class="container--narrow">
        <Breadcrumbs items={crumbs} />
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 id="hero-titel">{title}</h1>
        {intro && <p class="hero__intro">{intro}</p>}
        <slot />
      </div>
      <WaveDivider />
    </section>
    {img && (
      <figure class="container--narrow hero-figure">
        <SanityImg image={img} ratio={16 / 10} widths={[480, 820, 1140, 1640]} sizes="(min-width: 860px) 780px, 100vw" eager />
        {img.caption && <figcaption class="meta">{img.caption}</figcaption>}
      </figure>
    )}
  </>
)}

<style>
  .hero { position: relative; overflow: hidden; }
  .hero__grid { position: relative; display: grid; gap: 24px; }
  .hero__intro { font-size: var(--text-lg); max-width: 32em; margin-bottom: 1.4em; }

  /* Home */
  .hero--home { background: var(--gradient-hero); padding: 48px 0 0; }
  .hero--home::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 20% 30%, rgba(255,255,255,.22), transparent 55%); pointer-events: none; }
  .hero--home .hero__grid { align-items: end; }
  .hero__tekst { padding-bottom: 110px; }
  .hero--home h1 { font-size: var(--text-hero); max-width: 10.5em; margin-bottom: .3em; }
  .hero--home .hero__intro { color: var(--color-text); max-width: 30em; margin-bottom: 1.6em; }
  .hero__visual { position: relative; justify-self: center; width: min(100%, 540px); z-index: 3; margin-bottom: -40px; }
  .hero__visual img { width: 100%; height: auto; filter: drop-shadow(0 18px 24px rgba(120,70,0,.18)); }

  /* Hub */
  .hero--hub { padding: 36px 0 0; }
  .hero__grid--hub { align-items: center; padding-bottom: 96px; }
  .hero--hub h1 { font-size: var(--text-hub); max-width: 12em; margin-bottom: .35em; }
  .hero--hub .hero__intro { color: var(--color-text-muted); }
  .hero__illu { justify-self: center; width: min(100%, 380px); }
  .hero__illu :global(svg) { width: 100%; height: auto; }
  .hero--roze { background: var(--color-pink-soft); }
  .hero--geel { background: var(--gradient-hub-yellow); }
  .hero--sage { background: var(--color-sage-pale); }
  .hero--creme { background: var(--color-cream); }

  /* Plain */
  .hero--plain { background: var(--color-cream); padding: 36px 0 80px; }
  .hero--plain h1 { font-size: var(--text-hub); margin-bottom: .35em; }
  .hero--plain .hero__intro { color: var(--color-text-muted); }
  .hero--plain .eyebrow { margin-bottom: 8px; }
  .hero-figure { margin: 0 auto var(--space-2xl); }
  .hero-figure :global(img) { border-radius: var(--radius-lg); }
  .hero-figure figcaption { margin-top: 8px; }

  @media (min-width: 860px) {
    .hero--home { padding-top: 40px; }
    .hero--home .hero__grid { grid-template-columns: 1.1fr .9fr; gap: 40px; }
    .hero__tekst { padding-bottom: 140px; }
    .hero__visual { justify-self: end; margin-bottom: 0; }
    .hero__grid--hub { grid-template-columns: 1.2fr .8fr; gap: 48px; }
    .hero__illu { justify-self: end; }
  }
</style>
