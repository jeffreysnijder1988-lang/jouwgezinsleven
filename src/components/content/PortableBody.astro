---
/** Rendert Portable Text met centrale componenten. H1 in body wordt naar H2 gedegradeerd (één H1 per pagina). */
import { PortableText } from 'astro-portabletext';
import type { PortableTextBlock } from '@portabletext/types';
import LinkMark from './pt/LinkMark.astro';
import InternalLinkMark from './pt/InternalLinkMark.astro';
import PtImage from './pt/PtImage.astro';
interface Props { value?: PortableTextBlock[] | null; class?: string }
const { value, class: cls } = Astro.props;
const blocks = (value ?? []).map((b) => (b._type === 'block' && (b as { style?: string }).style === 'h1' ? { ...b, style: 'h2' } : b));
const components = {
  type: { image: PtImage },
  mark: { link: LinkMark, internalLink: InternalLinkMark },
};
---
{blocks.length > 0 && (
  <div class:list={['prose', cls]}>
    <PortableText value={blocks} components={components} onMissingComponent={false} />
  </div>
)}
