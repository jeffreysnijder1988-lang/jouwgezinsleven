---
/**
 * Responsieve Sanity-afbeelding met vaste aspect-ratio, width/height (tegen CLS),
 * lazy loading standaard en alt-tekst uit het contentmodel.
 */
import type { SanityImage } from '@/lib/content/types';
import { hasImage, imageSrcSet, imageUrl } from '@/lib/sanity/image';
interface Props {
  image?: SanityImage | null;
  ratio?: number;            // breedte / hoogte
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  decorative?: boolean;
  class?: string;
}
const { image, ratio = 16 / 9, widths = [480, 768, 1024, 1440], sizes = '100vw', eager = false, decorative = false, class: cls } = Astro.props;
const ok = hasImage(image);
const baseW = widths[Math.min(1, widths.length - 1)];
---
{ok && (
  <img
    src={imageUrl(image!, baseW, Math.round(baseW / ratio))}
    srcset={imageSrcSet(image!, widths, ratio)}
    sizes={sizes}
    width={baseW}
    height={Math.round(baseW / ratio)}
    alt={decorative ? '' : (image!.alt ?? '')}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : undefined}
    class={cls}
    style={`aspect-ratio:${ratio};object-fit:cover;width:100%`}
  />
)}
