---
/**
 * Decoratieve SVG-illustraties van de bestaande site (aria-hidden).
 * kind="feature": speeltuinscène in het featureblok.
 */
interface Props { kind: 'feature'; class?: string }
const { kind, class: cls } = Astro.props;
---


{kind === 'feature' && (
  <svg class={cls} viewBox="0 0 460 300" aria-hidden="true" focusable="false">
    <rect x="0" y="0" width="460" height="300" rx="20" fill="#3a4658"/>
    <path d="M0 300 L0 200 Q120 150 230 200 Q340 250 460 180 L460 300 Z" fill="#84A59D"/>
    <rect x="60" y="120" width="10" height="90" fill="#F7EDE2"/><rect x="150" y="120" width="10" height="90" fill="#F7EDE2"/>
    <rect x="50" y="112" width="120" height="10" rx="5" fill="#F28482"/>
    <path d="M85 122 L85 175" stroke="#F7EDE2" stroke-width="4"/><path d="M135 122 L135 175" stroke="#F7EDE2" stroke-width="4"/>
    <rect x="72" y="172" width="76" height="8" rx="4" fill="#F2BB6B"/>
    <path d="M300 90 L300 210" stroke="#F7EDE2" stroke-width="10" stroke-linecap="round"/>
    <path d="M300 95 L390 210" stroke="#F2BB6B" stroke-width="18" stroke-linecap="round"/>
    <circle cx="300" cy="80" r="16" fill="#F28482"/>
    <circle cx="410" cy="60" r="26" fill="#F2BB6B"/>
    <circle cx="230" cy="215" r="14" fill="#2D3748"/><rect x="220" y="228" width="20" height="30" rx="8" fill="#F5CAC3"/>
  </svg>
)}
